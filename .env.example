# ==============================================================================
# Tomir: Qishloq Med AI — Environment Configuration Template
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="Tomir: Qishloq Med AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENV="development"

# Authentication & Session Security
# Secret used for signing session cookies in production
SESSION_SECRET="your-32-byte-production-session-secret-key-here"

# Cloudflare R2 Storage Configuration (Zero-connectivity Encounter Payloads & Scans)
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="qishloqmed-encounters"

# AI Medical Assessment Engine API Key (Optional — Fallback to Deterministic Mock Engine)
TOMIR_AI_API_KEY="your_tomir_ai_inference_key"
TOMIR_AI_MODEL_ENDPOINT="https://api.qishloqmed.ai/v1/clinical-assess"

# Regional Dispatch & SMS Gateway Config (Zero-Connectivity Gateway)
SMS_GATEWAY_API_URL="https://sms.qishloqmed.uz/v1/send"
SMS_GATEWAY_SECRET="your_sms_gateway_shared_secret"

# Telemetry & Outbreak Monitoring
NEXT_PUBLIC_TELEMETRY_ENABLED="true"
NEXT_PUBLIC_OUTBREAK_RADAR_REFRESH_MS="5000"
